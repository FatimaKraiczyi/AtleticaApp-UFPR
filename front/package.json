{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "run:expo": "cd apps/expo-app && yarn expo start",
    "run:next": "cd apps/next && yarn dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "prettier": "^3.1.1",
    "turbo": "^2.1.2"
  },
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=18"
  },
  "name": "front",
  "dependencies": {
    "axios": "^1.7.7",
    "expo-network": "^6.0.1",
    "jwt-decode": "^4.0.0"
  }
}
